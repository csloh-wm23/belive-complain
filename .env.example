# Independent BeLive tenant-support configuration. Do not commit .env.
BELIVE_AI_PROVIDER=openai
BELIVE_AI_MODEL=
BELIVE_AI_KEY=
BELIVE_OLLAMA_URL=http://127.0.0.1:11434
BELIVE_OLLAMA_KEY=
# Prototype operational defaults, NOT confirmed BeLive SLAs.
BELIVE_ACK_MINUTES=30
BELIVE_FOLLOWUP_MINUTES=1440
# Optional HTTPS gateway for explicitly approved notifications.
BELIVE_NOTIFICATION_URL=
BELIVE_NOTIFICATION_SECRET=
# Official read APIs. Tokens are supplied by the authorised company operator.
BELIVE_GOOGLE_TOKEN=
BELIVE_FACEBOOK_TOKEN=
BELIVE_FACEBOOK_VERSION=
BELIVE_THREADS_TOKEN=
# Separate service clients can read only explicitly shared style examples.
# Example JSON: {"tenant-support-client":"a-long-random-secret"}
BELIVE_MEMORY_CLIENTS={}
