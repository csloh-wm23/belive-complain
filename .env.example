# Independent BeLive tenant-support configuration. Do not commit .env.
BELIVE_AI_PROVIDER=openai
BELIVE_AI_MODEL=gpt-6-luna
BELIVE_DECISIONS_ENABLED=true
BELIVE_AI_KEY=
BELIVE_OLLAMA_URL=http://127.0.0.1:11434
BELIVE_OLLAMA_KEY=

# Optional Complaint Code recovery (SMTP over TLS).
BELIVE_SMTP_HOST=
BELIVE_SMTP_PORT=465
BELIVE_SMTP_FROM=
BELIVE_SMTP_USER=
BELIVE_SMTP_PASSWORD=
# Prototype operational defaults, NOT confirmed BeLive SLAs.
BELIVE_ACK_MINUTES=30
BELIVE_FOLLOWUP_MINUTES=1440
# Optional HTTPS gateway for explicitly approved notifications.
BELIVE_NOTIFICATION_URL=
BELIVE_NOTIFICATION_SECRET=
# Official read APIs. Tokens are supplied by the authorised company operator.
BELIVE_GOOGLE_TOKEN=
# Enable only after the company authorises public replies; token needs business.manage scope.
BELIVE_GOOGLE_REPLY_ENABLED=false
BELIVE_FACEBOOK_TOKEN=
BELIVE_FACEBOOK_VERSION=
BELIVE_THREADS_TOKEN=
# Separate service clients can read only explicitly shared style examples.
# Example JSON: {"tenant-support-client":"a-long-random-secret"}
BELIVE_MEMORY_CLIENTS={}

# Passive WhatsApp Business Cloud API. Company-owned credentials; never commit .env.
BELIVE_WHATSAPP_ACCESS_TOKEN=
BELIVE_WHATSAPP_APP_SECRET=
BELIVE_WHATSAPP_VERIFY_TOKEN=
BELIVE_WHATSAPP_PHONE_NUMBER_ID=
# Supported Graph API version from the company's Meta app, e.g. vNN.N.
BELIVE_WHATSAPP_GRAPH_VERSION=
# Exact public HTTPS webhook hostname (no scheme/path). Only the webhook accepts it.
BELIVE_WHATSAPP_WEBHOOK_HOST=
# Public research domain allowlists. Never put customer data into search queries.
BELIVE_WA_COMPANY_DOMAINS=belive.asia
BELIVE_WA_TECH_DOMAINS=samsung.com,lg.com,bosch-home.com,electrolux.com,panasonic.com,haier.com,whirlpool.com,support.google.com,support.microsoft.com,support.apple.com
# Optional Responses API web-search-capable model; blank uses the configured model.
# BELIVE_WA_RESEARCH_MODEL=
